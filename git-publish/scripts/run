#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage:" >&2
  echo "  run prepare <pr|no-pr> --repo <path> [--topic <slug>] [--json]" >&2
  echo "  run publish <pr|no-pr> --repo <path> --plan <file-or-token> [--json]" >&2
  echo "  run push [<pr|no-pr>] --repo <path> [--topic <slug>] [--json] [point name...]    # self-authorizing publish to PR/no-pr" >&2
  echo "  run commit --repo <path> [--json] [point name...]" >&2
  echo "  run rebase --repo <path> [--remote <name>] [--base <branch>] [--json]" >&2
  echo "  run merge-done --repo <path> [--remote <name>] [--base <branch>] [--json] [point name...]" >&2
  echo "Aliases:" >&2
  echo "  commit: 'комит'" >&2
  echo "  rebase: 'ребейз'" >&2
  echo "  merge-done: 'мердж дан', 'мердж-дан'" >&2
  echo "Legacy:" >&2
  echo "  run <pr|no-pr> --repo <path> [--topic <slug>] [--dry-run] [--json]" >&2
  echo "Aliases for no-pr: 'пуш без пр', 'push no pr', 'push without pr'" >&2
}

normalize_mode() {
  case "${1:-}" in
    pr)
      echo "pr"
      ;;
    no-pr|no_pr|nopr|"пуш без пр"|"push no pr"|"push without pr")
      echo "no-pr"
      ;;
    *)
      echo "${1:-}"
      ;;
  esac
}

ACTION=""
MODE_RAW=""
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
case "${1:-}" in
  prepare|publish)
    ACTION="$1"
    shift
    if [[ $# -gt 0 && "${1:-}" != --* ]]; then
      MODE_RAW="$1"
      shift
    else
      MODE_RAW="pr"
    fi
    ;;
  push|пуш)
    ACTION="push"
    shift
    if [[ $# -gt 0 && "${1:-}" != --* ]]; then
      MODE_RAW="$1"
      shift
    else
      MODE_RAW="pr"
    fi
    ;;
  commit|комит)
    ACTION="commit"
    shift
    ;;
  rebase|ребейз)
    ACTION="rebase"
    shift
    ;;
  merge-done|merge_done|"мердж-дан"|"мердж дан")
    ACTION="merge-done"
    shift
    ;;
  мердж)
    if [[ "${2:-}" == "дан" ]]; then
      ACTION="merge-done"
      shift 2
    else
      ACTION="legacy"
      MODE_RAW="${1:-}"
      shift $(( $# > 0 ? 1 : 0 ))
    fi
    ;;
  *)
    ACTION="legacy"
    MODE_RAW="${1:-}"
    shift $(( $# > 0 ? 1 : 0 ))
    ;;
esac

MODE="$(normalize_mode "$MODE_RAW")"
REPO=""
TOPIC=""
PLAN=""
REMOTE=""
BASE=""
MESSAGE=""
PR_TITLE=""
POINT_NAME_PARTS=()
DRY_RUN=0
JSON=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo)
      REPO="${2:-}"
      shift 2
      ;;
    --topic)
      TOPIC="${2:-}"
      shift 2
      ;;
    --plan)
      PLAN="${2:-}"
      shift 2
      ;;
    --remote)
      REMOTE="${2:-}"
      shift 2
      ;;
    --base)
      BASE="${2:-}"
      shift 2
      ;;
    --message)
      MESSAGE="${2:-}"
      shift 2
      ;;
    --pr-title)
      PR_TITLE="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --json)
      JSON=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      POINT_NAME_PARTS+=("$1")
      shift
      ;;
  esac
done

POINT_NAME=""
if [[ ${#POINT_NAME_PARTS[@]} -gt 0 ]]; then
  POINT_NAME="${POINT_NAME_PARTS[*]}"
fi

if [[ "$ACTION" == "prepare" || "$ACTION" == "publish" || "$ACTION" == "legacy" ]]; then
  if [[ "$MODE" != "pr" && "$MODE" != "no-pr" ]]; then
    usage
    exit 2
  fi
fi

if [[ -z "$REPO" ]]; then
  echo "Missing required flag: --repo <path>" >&2
  usage
  exit 2
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
COMMON_ARGS=(--repo "$REPO")
if [[ -n "$REMOTE" ]]; then
  COMMON_ARGS+=(--remote "$REMOTE")
fi
if [[ -n "$BASE" ]]; then
  COMMON_ARGS+=(--base "$BASE")
fi
if [[ "$JSON" -eq 1 ]]; then
  COMMON_ARGS+=(--json)
fi

if [[ "$ACTION" == "commit" ]]; then
  COMMIT_ARGS=(--action commit "${COMMON_ARGS[@]}")
  if [[ -n "$POINT_NAME" ]]; then
    COMMIT_ARGS+=(--point-name "$POINT_NAME")
  fi
  exec python3 "$SCRIPT_DIR/git_publish.py" "${COMMIT_ARGS[@]}"
fi

if [[ "$ACTION" == "rebase" ]]; then
  exec python3 "$SCRIPT_DIR/git_publish.py" --action rebase "${COMMON_ARGS[@]}"
fi

if [[ "$ACTION" == "merge-done" ]]; then
  MERGE_ARGS=(--action merge-done "${COMMON_ARGS[@]}")
  if [[ -n "$POINT_NAME" ]]; then
    MERGE_ARGS+=(--point-name "$POINT_NAME")
  fi
  exec python3 "$SCRIPT_DIR/git_publish.py" "${MERGE_ARGS[@]}"
fi

if [[ "$ACTION" == "push" ]]; then
  PUSH_ARGS=(--action push --mode "$MODE" "${COMMON_ARGS[@]}")
  if [[ -n "$TOPIC" ]]; then
    PUSH_ARGS+=(--topic "$TOPIC")
  fi
  if [[ -n "$MESSAGE" ]]; then
    PUSH_ARGS+=(--message "$MESSAGE")
  fi
  if [[ -n "$PR_TITLE" ]]; then
    PUSH_ARGS+=(--pr-title "$PR_TITLE")
  fi
  if [[ -n "$POINT_NAME" ]]; then
    PUSH_ARGS+=(--point-name "$POINT_NAME")
  fi
  exec python3 "$SCRIPT_DIR/git_publish.py" "${PUSH_ARGS[@]}"
fi

if [[ "$ACTION" == "prepare" ]]; then
  PREPARE_ARGS=(--action prepare --mode "$MODE" "${COMMON_ARGS[@]}")
  if [[ -n "$TOPIC" ]]; then
    PREPARE_ARGS+=(--topic "$TOPIC")
  fi
  if [[ -n "$MESSAGE" ]]; then
    PREPARE_ARGS+=(--message "$MESSAGE")
  fi
  if [[ -n "$PR_TITLE" ]]; then
    PREPARE_ARGS+=(--pr-title "$PR_TITLE")
  fi
  exec python3 "$SCRIPT_DIR/git_publish.py" "${PREPARE_ARGS[@]}"
fi

if [[ "$ACTION" == "publish" ]]; then
  if [[ -z "$PLAN" ]]; then
    echo "Missing required flag: --plan <file-or-token>" >&2
    usage
    exit 2
  fi
  exec python3 "$SCRIPT_DIR/git_publish.py" --action publish --mode "$MODE" "${COMMON_ARGS[@]}" --plan "$PLAN"
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
  PREPARE_ARGS=(--action prepare --mode "$MODE" "${COMMON_ARGS[@]}")
  if [[ -n "$TOPIC" ]]; then
    PREPARE_ARGS+=(--topic "$TOPIC")
  fi
  if [[ -n "$MESSAGE" ]]; then
    PREPARE_ARGS+=(--message "$MESSAGE")
  fi
  if [[ -n "$PR_TITLE" ]]; then
    PREPARE_ARGS+=(--pr-title "$PR_TITLE")
  fi
  exec python3 "$SCRIPT_DIR/git_publish.py" "${PREPARE_ARGS[@]}"
fi

PREPARE_ARGS=(--action prepare --mode "$MODE" --repo "$REPO" --json)
if [[ -n "$REMOTE" ]]; then
  PREPARE_ARGS+=(--remote "$REMOTE")
fi
if [[ -n "$BASE" ]]; then
  PREPARE_ARGS+=(--base "$BASE")
fi
if [[ -n "$TOPIC" ]]; then
  PREPARE_ARGS+=(--topic "$TOPIC")
fi
if [[ -n "$MESSAGE" ]]; then
  PREPARE_ARGS+=(--message "$MESSAGE")
fi
if [[ -n "$PR_TITLE" ]]; then
  PREPARE_ARGS+=(--pr-title "$PR_TITLE")
fi
PLAN_OUTPUT="$(python3 "$SCRIPT_DIR/git_publish.py" "${PREPARE_ARGS[@]}")"
INCLUDED_COUNT="$(printf '%s\n' "$PLAN_OUTPUT" | python3 -c 'import json,sys; print(len(json.load(sys.stdin)["included_paths"]))')"
if [[ "$INCLUDED_COUNT" == "0" ]]; then
  if [[ "$JSON" -eq 1 ]]; then
    printf '%s\n' "$PLAN_OUTPUT"
  else
    echo "No changes to publish."
  fi
  exit 0
fi
PLAN_PATH="$(printf '%s\n' "$PLAN_OUTPUT" | python3 -c 'import json,sys; print(json.load(sys.stdin)["plan_path"])')"
exec python3 "$SCRIPT_DIR/git_publish.py" --action publish --mode "$MODE" "${COMMON_ARGS[@]}" --plan "$PLAN_PATH"
